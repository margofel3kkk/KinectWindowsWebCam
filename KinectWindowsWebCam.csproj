<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <DebugType>embedded</DebugType>
    <SatelliteResourceLanguages>none</SatelliteResourceLanguages>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AssemblyName>KinectWindowsWebCam</AssemblyName>
    <RootNamespace>KinectWindowsWebCam</RootNamespace>
    <Product>Kinect Windows WebCam</Product>
    <AssemblyTitle>Kinect Windows WebCam</AssemblyTitle>
    <Version>1.1.0</Version>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="third_party\UnityCapture\UnityCaptureFilter32.dll" LogicalName="UnityCaptureFilter32.dll" />
    <EmbeddedResource Include="third_party\UnityCapture\UnityCaptureFilter64.dll" LogicalName="UnityCaptureFilter64.dll" />
    <EmbeddedResource Include="third_party\UnityCapture\LICENSE.txt" LogicalName="UnityCapture-LICENSE.txt" />
  </ItemGroup>
</Project>
